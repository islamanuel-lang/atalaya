# Cloudflare Pages: cabeceras de seguridad y caché. Sin rastreo.
# Nota: _headers usa # para comentarios.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self' https://semencheck.es https://api.semencheck.es https://atalaya-keie.onrender.com https://*.workers.dev; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=604800

/*.html
  Cache-Control: public, max-age=60
